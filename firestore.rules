rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function claimExists() {
      return signedIn() && exists(/databases/$(database)/documents/accessClaims/$(request.auth.uid));
    }
    function claim() {
      return get(/databases/$(database)/documents/accessClaims/$(request.auth.uid)).data;
    }
    function isOwner(tid) {
      return signedIn()
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.ownerUid == request.auth.uid;
    }
    function isAdmin(tid) {
      return isOwner(tid)
        || (claimExists() && claim().tournamentId == tid && claim().role == 'admin');
    }
    function isGroupScorer(tid) {
      return claimExists()
        && claim().tournamentId == tid
        && claim().role == 'group'
        && claim().group is int
        && claim().group >= 1
        && claim().group <= 6;
    }
    function playerIsInClaimedGroup(tid, playerId) {
      return isGroupScorer(tid)
        && exists(/databases/$(database)/documents/tournaments/$(tid)/players/$(playerId))
        && get(/databases/$(database)/documents/tournaments/$(tid)/players/$(playerId)).data.group == claim().group;
    }
    function validScoreDocument(sid) {
      return request.resource.data.keys().hasOnly(['playerId', 'hole', 'gross', 'updatedAt'])
        && request.resource.data.playerId is string
        && request.resource.data.hole is int
        && request.resource.data.hole >= 1
        && request.resource.data.hole <= 18
        && request.resource.data.gross is int
        && request.resource.data.gross >= 1
        && request.resource.data.gross <= 12
        && sid == request.resource.data.playerId + '_' + string(request.resource.data.hole);
    }

    match /publicConfig/{doc} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.data.tournamentId is string
        && isAdmin(request.resource.data.tournamentId);
    }

    match /accessLinks/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if signedIn()
        && isAdmin(request.resource.data.tournamentId);
    }

    match /accessClaims/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.token is string
        && exists(/databases/$(database)/documents/accessLinks/$(request.resource.data.token))
        && get(/databases/$(database)/documents/accessLinks/$(request.resource.data.token)).data.active == true
        && request.resource.data.tournamentId == get(/databases/$(database)/documents/accessLinks/$(request.resource.data.token)).data.tournamentId
        && request.resource.data.role == get(/databases/$(database)/documents/accessLinks/$(request.resource.data.token)).data.role
        && request.resource.data.group == get(/databases/$(database)/documents/accessLinks/$(request.resource.data.token)).data.group;
      // A browser identity cannot switch itself from one group to another.
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin(tid)
        || (signedIn() && !('ownerUid' in resource.data) && request.resource.data.ownerUid == request.auth.uid);

      match /players/{pid} {
        allow read: if true;
        allow write: if isAdmin(tid);
      }

      match /scores/{sid} {
        allow read: if true;
        allow create: if isAdmin(tid)
          || (validScoreDocument(sid)
            && playerIsInClaimedGroup(tid, request.resource.data.playerId));
        allow update: if isAdmin(tid)
          || (validScoreDocument(sid)
            && request.resource.data.playerId == resource.data.playerId
            && request.resource.data.hole == resource.data.hole
            && playerIsInClaimedGroup(tid, resource.data.playerId));
        allow delete: if isAdmin(tid);
      }

      match /privateLinks/{key} {
        allow read, write: if isAdmin(tid);
      }
    }
  }
}
