rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function tournament(tid){ return get(/databases/$(database)/documents/tournaments/$(tid)); }
    function isAdmin(tid){ return signedIn() && tournament(tid).data.adminUid == request.auth.uid; }
    function claim(tid){ return get(/databases/$(database)/documents/tournaments/$(tid)/claims/$(request.auth.uid)); }
    function isGroup(tid,g){ return signedIn() && claim(tid).data.role == 'group' && claim(tid).data.group == g; }

    match /public/{docId} {
      allow read: if true;
      allow create, update: if signedIn() && get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.adminUid == request.auth.uid;
      allow delete: if false;
    }
    match /tournaments/{tid} {
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if isAdmin(tid);


      match /access/{docId} {
        allow read, write: if isAdmin(tid);
      }

      match /claims/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin(tid));
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.role == 'group'
          && request.resource.data.group >= 1 && request.resource.data.group <= 6
          && ((request.resource.data.group == 1 && request.resource.data.token == get(/databases/$(database)/documents/tournaments/$(tid)/access/private).data.groupTokens.g1) || (request.resource.data.group == 2 && request.resource.data.token == get(/databases/$(database)/documents/tournaments/$(tid)/access/private).data.groupTokens.g2) || (request.resource.data.group == 3 && request.resource.data.token == get(/databases/$(database)/documents/tournaments/$(tid)/access/private).data.groupTokens.g3) || (request.resource.data.group == 4 && request.resource.data.token == get(/databases/$(database)/documents/tournaments/$(tid)/access/private).data.groupTokens.g4) || (request.resource.data.group == 5 && request.resource.data.token == get(/databases/$(database)/documents/tournaments/$(tid)/access/private).data.groupTokens.g5) || (request.resource.data.group == 6 && request.resource.data.token == get(/databases/$(database)/documents/tournaments/$(tid)/access/private).data.groupTokens.g6));
        allow update: if false;
        allow delete: if isAdmin(tid);
      }
      match /players/{pid} {
        allow read: if signedIn();
        allow write: if isAdmin(tid);
      }
      match /scores/{sid} {
        allow read: if signedIn();
        allow create, update: if isAdmin(tid) || (
          isGroup(tid, request.resource.data.group)
          && get(/databases/$(database)/documents/tournaments/$(tid)/players/$(request.resource.data.playerId)).data.group == request.resource.data.group
          && request.resource.data.updatedBy == request.auth.uid
        );
        allow delete: if isAdmin(tid);
      }
    }
  }
}